# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# 本地用 server/server.js 开发时读取本文件。
#
# ⚠️ 部署到 EdgeOne Makers（全栈 / edge-functions）时：
#    密钥请配置在 EdgeOne 控制台 → 项目设置 → 环境变量 里，
#    不要写进仓库任何文件。本 .env 仅用于本地 node server.js。
# ⚠️ 密钥一旦在聊天/前端泄露，请立即到 Stripe 后台轮换！

# Stripe 密钥（仅服务端使用，出现在浏览器即视为已泄露）
# ⚠️ 仅占位符：GitHub 密钥扫描会拦截 sk_live_/whsec_ 后接 16+ 位字母数字的格式，
#    所以这里用 PLACEHOLDER（不足 16 位）避免误报。部署时请把真实值填到 .env 或
#    EdgeOne 控制台环境变量，绝不要写进仓库。
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# 支付成功/取消回跳的前端地址（部署后改为线上域名）
FRONTEND_URL=https://onewishwillow.bvip.one

# 本地服务端口
PORT=8788
